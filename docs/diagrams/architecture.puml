@startuml architecture
title TuneVault - System Architecture

skinparam componentStyle rectangle

actor "User" as user

node "Browser" {
  [React SPA\n(Vite build)] as spa
  [HTML5 <audio>] as audio
}

node "Docker Container" {
  [Express HTTP Server] as express
  package "Routes" {
    [tracks] as rTracks
    [library] as rLibrary
    [playlists] as rPlaylists
    [uploads] as rUploads
    [artwork] as rArtwork
  }
  package "Services" {
    [importService] as sImport
    [archiveService] as sArchive
    [metadataLookupService] as sLookup
    [artworkService] as sArtwork
    [artistImageService] as sArtistImg
    [genreNormalizationService] as sGenre
    [enrichmentService] as sEnrich
    [tagWriterService] as sTagWriter
  }
  database "SQLite\nlibrary.db" as db
}

folder "/data (host volume)" {
  folder "music/ (audio files)" as musicFs
  folder "covers/ (album art)" as coversFs
  folder "artists/ (artist photos)" as artistsFs
}

cloud "Open APIs" {
  [iTunes Search API] as itunes
  [MusicBrainz +\nCover Art Archive] as mb
  [Deezer API] as deezer
}

user --> spa
spa --> express : REST /api/*
audio --> rTracks : GET /stream (HTTP range)

express --> rTracks
express --> rLibrary
express --> rPlaylists
express --> rUploads
express --> rArtwork

rUploads --> sImport
rTracks --> sArchive
rTracks --> sEnrich
rLibrary --> sArchive
rLibrary --> sEnrich
rPlaylists --> sArchive
sImport --> sArtwork
sEnrich --> sLookup
sEnrich --> sArtwork
sEnrich --> sTagWriter
sLookup --> itunes
sLookup --> mb
sLookup --> deezer
rArtwork --> sArtistImg
sArtistImg --> deezer
sArtistImg --> artistsFs : cache artist photos
sImport --> sGenre
sLookup --> sGenre
rTracks --> sGenre
rLibrary --> sGenre

sImport --> musicFs : store files
sArtwork --> coversFs : store covers
sTagWriter --> musicFs : write tags + covers\ninto audio files
rTracks --> musicFs : read files
rArtwork --> coversFs : read covers

rTracks --> db
rLibrary --> db
rPlaylists --> db
sImport --> db
sEnrich --> db
@enduml
